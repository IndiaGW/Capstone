def calc_nutri_add(TDS_current, TDS_min, vol)):
  nutri_sol_TDS = #TBD in mg/L
  diff = TDS_current - TDS_min #mg/L
  mg_nutri = diff*vol #mg to add
  mL_add = mg_nutri /(nutri_sol_TDS*1000)
  run_time = int(mL_add/1.333)
  
