def control_loop(moisture_desired, TDS_desired, pH_desired):

  while 1: #loop continuously, to change
    moisture = moisture_check(moisture_desired)
    if moisture == 1:
      pump_mix()

      TDS = TDS_check(TDS_desired)

      if TDS == 1:
        nutri_time = calc_nutri_add()
        pump_nutri(nutri_time)
        return
    else:
      continue

      pH = pH_check(pH_desired)

      if pH != 0:
        pH_time = calc_pH_add()
        pump_pH(pH_time,pH)
        return

      else:
        continue

      run_water(5)


# Basic peripheral control functions


def moisture_check(moisture_desired):

    if moisture < moisture_desired:
      moistureStatus = 1
    else:
      moistureStatus = 0

    return moistureStatus

def TDS_check(TDS_desired):

    if TDS < TDS_desired:
      TDSStatus = 1
    else:
      TDSStatus = 0

    return TDSStatus
    
def pH_check(pH_desired):

    if pH > pH_desired+0.5: #basic
      pHStatus = 1
    elif pH < pH_desired-0.5: #acidic
      pHStatus = -1
    else:
      pHStatus = 0

    return pHStatus

def run_water(time):
  pump_GPIO = #tbd
  GPIO.output(pump_GPIO, GPIO.HIGH)
  time.sleep(time)
  GPIO.output(pump_GPIO, GPIO.LOW)
    return time*222 #mL pumped

def pump_pH(time, upORdn):
    pumpUP_GPIO = #tbd
    pumpDN_GPIO = #tbd
    if upORdn == -1: #acidic add base
        GPIO.output(pumpUP_GPIO, GPIO.HIGH)
        time.sleep(time)
        GPIO.output(pumpUP_GPIO, GPIO.LOW)

        elif upORdn == 1: #basic add acid
        GPIO.output(pumpDN_GPIO, GPIO.HIGH)
        time.sleep(time)
        GPIO.output(pumpDN_GPIO, GPIO.LOW)

    return time*1.333 #mL pumped


def pump_nutri(time):
    pump_GPIO = #tbd
    GPIO.output(pump_GPIO, GPIO.HIGH)
    time.sleep(time)
    GPIO.output(pump_GPIO, GPIO.LOW)
    return time*1.333 #mL pumped

def pump_mix():
    run_water(2)
    time.sleep(2)
    run_water(2)
    time.sleep(2)
    run_water(2)
    time.sleep(2)
    return

