  vol = 9000#mL

  while 1: #loop continuously, to change
    moisture = moisture_check(moisture_desired)
    if moisture == 1:
      pump_mix()

      TDS_ok = TDS_check(TDS_desired)
      TDS = voltage_to_TDS(ADS.P2)

      if TDS_ok == 1:
        nutri_time = calc_nutri_add(TDS_current, TDS_min, vol)
