def moisture_check(moisture_desired):

    if moisture < moisture_desired:
      moistureStatus = 1
    else:
      moistureStatus = 0

    return moistureStatus

def TDS_check(TDS_desired):
    TDS = voltage_to_TDS(ADS.P2)
    if TDS < TDS_desired:
      TDSStatus = 1
    else:
      TDSStatus = 0

    return TDSStatus
    
def pH_check(pH_desired):
    pH = voltage_to_pH(ADS.P0)
    if pH > pH_desired+0.5: #basic
      pHStatus = 1
    elif pH < pH_desired-0.5: #acidic
      pHStatus = -1
    else:
      pHStatus = 0

    return pHStatus

def run_water(time):
  pump_GPIO = GPIO26
  GPIO.output(pump_GPIO, GPIO.HIGH)
  time.sleep(time)
  GPIO.output(pump_GPIO, GPIO.LOW)
    return time*222 #mL pumped

def pump_pH(time, upORdn):
    pumpUP_GPIO = GPIO19 #DOSER1
    pumpDN_GPIO = GPIO13 #DOSER2
    if upORdn == -1: #acidic add base
        GPIO.output(pumpUP_GPIO, GPIO.HIGH)
        time.sleep(time)
        GPIO.output(pumpUP_GPIO, GPIO.LOW)

        elif upORdn == 1: #basic add acid
        GPIO.output(pumpDN_GPIO, GPIO.HIGH)
        time.sleep(time)
        GPIO.output(pumpDN_GPIO, GPIO.LOW)

    return time*1.333 #mL pumped


def pump_nutri(time):
    pump_GPIO = GPIO6 #DOSER3
    GPIO.output(pump_GPIO, GPIO.HIGH)
    time.sleep(time)
    GPIO.output(pump_GPIO, GPIO.LOW)
    return time*1.333 #mL pumped

def pump_mix():
    run_water(2)
